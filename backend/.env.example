# Environment variables for backend

# Application
APP_NAME="Bid Review Agent"
DEBUG=false

# Security
SECRET_KEY="your-secret-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
DATABASE_URL="postgresql+asyncpg://user:password@host:port/database"

# Redis
REDIS_URL="redis://host:port/0"

# Operate platform integration. Pre-release/dev usually uses direct backend URL
# without /prod-api; production uses the nginx URL with /prod-api.
# 企业私有云部署：指向"私有云后台管理系统"（如 http://192.168.1.10:40008，不带 /prod-api），
# 并设置 BILLING_MODE=private_cloud —— 登录/预检/结算/OCR 计量全部走私有云后台。
OPERATE_API_BASE_URL="http://127.0.0.1:40000"
OPERATE_INTERNAL_TOKEN=""

# 计费模式：wallet=公有云钱包点数（默认）；private_cloud=私有云次数配额
# （充值/优惠券/短信注册重置自动禁用；OPERATE_INTERNAL_TOKEN 须与私有云后台
#  的 pc.internal-token 同值，OPERATE_API_BASE_URL 指向私有云后台管理系统）
BILLING_MODE=wallet

# 充值套餐全部使用真实交行支付。以下配置只控制套餐可见性。
#   dev:  BILLING_TEST_PACKAGE_ENABLED=true（显式开启 1 分钱真实支付测试套餐）
#   prod: BILLING_HIDDEN_PACKAGE_CODES="test"（双保险，配合 BILLING_TEST_PACKAGE_ENABLED 默认 false）
BILLING_HIDDEN_PACKAGE_CODES=""
# 测试套餐开关：默认 false（fail-closed）。prod 切勿设为 true；dev 设 true 才能在充值页看到 1 分钱测试套餐。
BILLING_TEST_PACKAGE_ENABLED=false

# RAG Memory Service
RAG_MEMORY_SERVICE_URL="http://localhost:3001"

# OCR Service (leave empty for local RapidOCR mode)
OCR_SERVICE_URL=""

# 图像理解引擎切换：minimax（默认，MiniMax MCP VLM）/ baidu（百度云 OCR）/ volcengine
IMAGE_UNDERSTANDING_PROVIDER="minimax"

# 百度云 OCR（通用文字识别-高精度版 accurate_basic），IMAGE_UNDERSTANDING_PROVIDER=baidu 时必填
BAIDU_OCR_APP_ID="your-baidu-app-id"
BAIDU_OCR_API_KEY="your-baidu-api-key"
BAIDU_OCR_SECRET_KEY="your-baidu-secret-key"

# Mini-Agent API
MINI_AGENT_API_KEY="your-minimax-api-key"
MINI_AGENT_API_BASE="https://api.minimaxi.com"
MINI_AGENT_MODEL="MiniMax-M2.7-highspeed"
MINIMAX_EMBEDDING_MODEL="embo-01"

# Duplicate semantic recall is independent from LLM_PROVIDER.  Use the
# bounded task-local LLM clusterer unless a working embedding endpoint/model
# has been explicitly provisioned.
DUPLICATE_SEMANTIC_PROVIDER="llm"

# LLM Provider: "minimax" (default), "volcengine", "deepseek", or "tencent"
LLM_PROVIDER="minimax"

# Volcengine / 火山引擎
VOLCENGINE_API_KEY="your-volcengine-api-key"
VOLCENGINE_API_BASE="https://ark.cn-beijing.volces.com/api/v3"
VOLCENGINE_MODEL="doubao-seed-2-0-pro-260215"

# DeepSeek
DEEPSEEK_API_KEY="your-deepseek-api-key"
DEEPSEEK_API_BASE="https://api.deepseek.com/v1"
DEEPSEEK_MODEL="deepseek-v4-flash"

# Tencent Cloud TokenHub（腾讯云大模型服务平台，OpenAI 兼容协议）
# 对接文档: https://cloud.tencent.com/document/product/1823/132248
TENCENT_API_KEY="your-tencent-tokenhub-api-key"
TENCENT_API_BASE="https://tokenhub.tencentmaas.com/v1"
TENCENT_MODEL="deepseek-v4-flash"

# Workspace
WORKSPACE_DIR="./workspace"
DUPLICATE_RULE_LIBRARY_DIR="./docs/rules-duplicate"

# File Upload
# 单连接上传限速（字节/秒）；0=不限速。后端流式分块读取实现，
# 因 nginx proxy_request_buffering off，端到端限速成立。默认 4 MiB/s（1GiB ≈ 256s）。
# 集群每 IP 并发上传上限由 nginx limit_conn 控制（见 deploy/nginx/bjt-cluster）。
UPLOAD_BYTES_PER_SEC=4194304

# Rule Library
RULE_LIBRARY_DIR="./docs/rules"

# Proxy
HTTP_PROXY="http://127.0.0.1:7890"
HTTPS_PROXY="http://127.0.0.1:7890"

# Sub-Agent Concurrency
MAX_SUB_AGENT_CONCURRENCY=2
MAX_LLM_CONCURRENCY=0

# Sub-Agent 运行参数（500 步上限 + 宽松超时）
# 子代理最大执行步数（单项检查脑容量上限：brain_capacity = actual_steps / max_steps × 100%）
SUB_AGENT_MAX_STEPS=500
# 进度看门狗：无 SSE 事件多久判卡死（500 步下单步偶发慢需更长容忍）
AGENT_PROGRESS_TIMEOUT=1200
# 任务绝对超时（500 步上界，~30s/步 ≈ 4.2h，6h 留余量；与 Celery time_limit 配合）
AGENT_TOTAL_TIMEOUT=21600

# LLM 单次调用超时与超时重试（防偶发卡顿毁掉整个子任务）
# 单次调用的 asyncio 超时秒数（httpx 客户端自身 timeout=120s 会先触发内层重试）
LLM_CALL_TIMEOUT=180
# 超时后最多重试次数（总尝试 = 1 + 此值；重试间隔固定，给模型端恢复时间）
LLM_TIMEOUT_MAX_RETRIES=2
LLM_TIMEOUT_RETRY_DELAY=5.0
